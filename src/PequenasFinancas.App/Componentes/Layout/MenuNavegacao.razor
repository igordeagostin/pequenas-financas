@namespace PequenasFinancas.App.Componentes.Layout

<nav class="barra-lateral">
    <div class="marca">
        <img class="marca-simbolo" src="img/logo.svg" alt="Pequenas Finanças" />
        <div class="marca-nome">
            Pequenas Finanças
            <small>quanto sobra livre no mês</small>
        </div>
    </div>

    @foreach (TelaDoApp tela in TelasDoApp.Todas)
    {
        <NavLink class="item-menu" href="@tela.Rota" Match="@(tela.EhARaiz ? NavLinkMatch.All : NavLinkMatch.Prefix)">
            <Icone Nome="tela.Icone" /> @tela.Nome
        </NavLink>
    }
</nav>
