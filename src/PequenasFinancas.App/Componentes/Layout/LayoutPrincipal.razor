@namespace PequenasFinancas.App.Componentes.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject EstadoAplicacao Estado
@inject ServicoExibicao ServicoDeExibicao
@inject NavigationManager Navegacao

<div class="aplicacao">
    <MenuNavegacao />

    <div class="conteudo">
        <header class="topo">
            <SeletorMes />
            <span class="texto-suave texto-pequeno">Dados salvos no seu computador</span>
        </header>

        <main class="area-rolavel">
            @Body
        </main>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Estado.MesAlterado += AoTrocarDeMes;
        AbrirTelaEscolhida();
    }

    public void Dispose() => Estado.MesAlterado -= AoTrocarDeMes;

    private void AoTrocarDeMes() => InvokeAsync(StateHasChanged);

    private void AbrirTelaEscolhida()
    {
        if (Navegacao.ToBaseRelativePath(Navegacao.Uri).Length > 0)
        {
            return;
        }

        string rota = TelasDoApp.RotaDe(ServicoDeExibicao.Preferencias.TelaInicial);

        if (rota.Length > 0)
        {
            Navegacao.NavigateTo(rota);
        }
    }
}
