@namespace PequenasFinancas.App.Componentes.Compartilhados

<div class="estado-vazio">
    <Icone Nome="Simbolo" />
    <p>@Mensagem</p>
    @if (Acao is not null)
    {
        @Acao
    }
</div>

@code {
    [Parameter]
    public NomeIcone Simbolo { get; set; } = NomeIcone.Vazio;

    [Parameter, EditorRequired]
    public string Mensagem { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? Acao { get; set; }
}
