@namespace PequenasFinancas.App.Componentes.Compartilhados
@inject ServicoPagamentos ServicoDePagamentos

<button type="button" class="botao botao-marcador @(EstaPago ? "pago" : string.Empty)"
        title="@Dica" @onclick="Alternar">
    <Icone Nome="@(EstaPago ? NomeIcone.Pago : NomeIcone.APagar)" /> @Texto
</button>

@code {
    [Parameter, EditorRequired]
    public TipoPagavel Tipo { get; set; }

    [Parameter, EditorRequired]
    public Guid ItemId { get; set; }

    [Parameter, EditorRequired]
    public Competencia Mes { get; set; }

    [Parameter]
    public EventCallback AoAlterar { get; set; }

    private bool EstaPago => ServicoDePagamentos.EstaPago(Tipo, ItemId, Mes);

    private string Texto => EstaPago ? "Pago" : "Marcar pago";

    private string Dica
        => EstaPago
            ? $"Pago em {Mes.NomeCurto}. Clique para desmarcar."
            : $"Marcar como pago em {Mes.NomeCurto}.";

    private async Task Alternar()
    {
        ServicoDePagamentos.Alternar(Tipo, ItemId, Mes);
        await AoAlterar.InvokeAsync();
    }
}
