@namespace PequenasFinancas.App.Componentes.Compartilhados

<div class="cartao-valor @(Destaque ? "destaque" : string.Empty)">
    <div class="rotulo"><Icone Nome="Simbolo" /> @Rotulo</div>
    <div class="valor @ClasseDeCor">@Dinheiro.Formatar(Valor)</div>
    @if (!string.IsNullOrWhiteSpace(Apoio))
    {
        <div class="apoio">@Apoio</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Rotulo { get; set; } = string.Empty;

    [Parameter]
    public NomeIcone Simbolo { get; set; } = NomeIcone.Vazio;

    [Parameter]
    public decimal Valor { get; set; }

    [Parameter]
    public string? Apoio { get; set; }

    [Parameter]
    public bool Destaque { get; set; }

    [Parameter]
    public bool? EhEntrada { get; set; }

    [Parameter]
    public bool ColorirPeloSinal { get; set; }

    private string ClasseDeCor
    {
        get
        {
            if (ColorirPeloSinal)
            {
                return Valor < 0 ? "texto-saida" : "texto-entrada";
            }

            return EhEntrada switch
            {
                true => "texto-entrada",
                false => "texto-saida",
                _ => string.Empty
            };
        }
    }
}
