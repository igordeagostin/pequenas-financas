@namespace PequenasFinancas.App.Componentes.Compartilhados

<div class="campo">
    @if (!string.IsNullOrWhiteSpace(Rotulo))
    {
        <label>@Rotulo</label>
    }
    <input type="text" inputmode="decimal" placeholder="0,00"
           value="@TextoDigitado" @oninput="AoDigitar" @onblur="AoSairDoCampo" />
    @if (!string.IsNullOrWhiteSpace(Ajuda))
    {
        <div class="ajuda">@Ajuda</div>
    }
</div>

@code {
    [Parameter]
    public string? Rotulo { get; set; }

    [Parameter]
    public string? Ajuda { get; set; }

    [Parameter]
    public decimal Valor { get; set; }

    [Parameter]
    public EventCallback<decimal> ValorChanged { get; set; }

    private string TextoDigitado { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        if (TextoRepresentaValorAtual())
        {
            return;
        }

        TextoDigitado = FormatarValorAtual();
    }

    private Task AoDigitar(ChangeEventArgs argumentos)
    {
        var texto = argumentos.Value?.ToString() ?? string.Empty;
        TextoDigitado = texto;

        if (!Dinheiro.TentarConverter(texto, out var valorDigitado) || valorDigitado < 0m)
        {
            return Task.CompletedTask;
        }

        Valor = valorDigitado;
        return ValorChanged.InvokeAsync(valorDigitado);
    }

    private void AoSairDoCampo() => TextoDigitado = FormatarValorAtual();

    private bool TextoRepresentaValorAtual()
        => Dinheiro.TentarConverter(TextoDigitado, out var valorDoTexto) && valorDoTexto == Valor;

    private string FormatarValorAtual()
        => Valor == 0m ? string.Empty : Dinheiro.FormatarParaEdicao(Valor);
}
