@page "/parcelamentos"
@namespace PequenasFinancas.App.Componentes.Paginas
@inherits PaginaCadastro<Parcelamento>
@inject ServicoParcelamentos ServicoDeParcelamentos

<CabecalhoPagina Titulo="Parcelados sem cartão"
                 Explicacao="Carnê, boleto, empréstimo ou acordo que você paga em parcelas, fora do cartão.">
    <Acoes>
        <button class="botao" @onclick="AbrirNovo"><Icone Nome="NomeIcone.Adicionar" /> Novo parcelado</button>
    </Acoes>
</CabecalhoPagina>

<div class="painel">
    <div class="painel-cabecalho">
        <h2>Suas parcelas fora do cartão</h2>
        <label class="texto-suave texto-pequeno">
            <input type="checkbox" @bind="MostrarSomenteDoMes" />
            mostrar só o que cai em @MesSelecionado.NomeCurto
        </label>
    </div>

    @if (ParcelamentosVisiveis.Count == 0)
    {
        <EstadoVazio Simbolo="NomeIcone.Parcelado" Mensagem="Nenhum parcelado para mostrar.">
            <Acao>
                <button class="botao" @onclick="AbrirNovo">Cadastrar um parcelado</button>
            </Acao>
        </EstadoVazio>
    }
    else
    {
        <table class="tabela">
            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Para quem</th>
                    <th>Parcelas</th>
                    <th>Período</th>
                    <th>Neste mês</th>
                    <th class="direita">Falta pagar</th>
                    <th class="acoes"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (Parcelamento parcelamento in ParcelamentosVisiveis)
                {
                    <tr>
                        <td>
                            <strong>@parcelamento.Descricao</strong>
                            <div class="texto-suave texto-pequeno">
                                @Dinheiro.Formatar(parcelamento.ValorTotal)
                                @if (!string.IsNullOrWhiteSpace(parcelamento.Categoria))
                                {
                                    <text> · @parcelamento.Categoria</text>
                                }
                            </div>
                        </td>
                        <td class="texto-suave">@parcelamento.Credor</td>
                        <td class="numero">@DescritorParcelamento.Parcelas(parcelamento)</td>
                        <td class="texto-suave">@DescritorParcelamento.Periodo(parcelamento)</td>
                        <td class="texto-suave">@DescritorParcelamento.SituacaoNoMes(parcelamento, MesSelecionado)</td>
                        <td class="direita numero">
                            @Dinheiro.Formatar(DescritorParcelamento.ValorEmAberto(parcelamento, MesSelecionado))
                        </td>
                        <td class="acoes">
                            <button class="botao botao-secundario" @onclick="() => AbrirEdicao(parcelamento)">Editar</button>
                            <button class="botao botao-perigo" @onclick="() => PedirExclusao(parcelamento)">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<ModalFormulario Visivel="FormularioAberto"
                 Titulo="@(EhCadastroNovo ? "Novo parcelado" : "Editar parcelado")"
                 Erro="@MensagemDeErro"
                 AoConfirmar="ConfirmarFormulario"
                 AoCancelar="FecharFormulario">
    @if (ItemEmEdicao is Parcelamento parcelamento)
    {
        <div class="previa">@MontarPrevia(parcelamento)</div>

        <div class="campo">
            <label>O que você parcelou</label>
            <input type="text" placeholder="Ex.: Sofá" @bind="parcelamento.Descricao" @bind:event="oninput" />
        </div>

        <div class="linha-campos">
            <div class="campo">
                <label>Para quem você paga</label>
                <input type="text" placeholder="Ex.: Loja de móveis" @bind="parcelamento.Credor" @bind:event="oninput" />
            </div>

            <CampoMoeda Rotulo="Valor total" @bind-Valor="parcelamento.ValorTotal" />
        </div>

        <div class="linha-campos">
            <div class="campo">
                <label>Em quantas vezes</label>
                <input type="number" min="1" max="120" @bind="parcelamento.QuantidadeParcelas" @bind:event="oninput" />
            </div>

            <CampoMes Rotulo="Mês da 1ª parcela"
                      Valor="parcelamento.CompetenciaPrimeiraParcela"
                      ValorChanged="mes => DefinirPrimeiraParcela(parcelamento, mes)" />

            <div class="campo">
                <label>Categoria</label>
                <input type="text" placeholder="Ex.: Casa" @bind="parcelamento.Categoria" @bind:event="oninput" />
            </div>
        </div>
    }
</ModalFormulario>

<ModalConfirmacao Visivel="ItemParaExcluir is not null"
                  Descricao="@(ItemParaExcluir is null ? string.Empty : DescreverParaExclusao(ItemParaExcluir))"
                  AoConfirmar="ConfirmarExclusao"
                  AoCancelar="CancelarExclusao" />

@code {
    private bool MostrarSomenteDoMes;

    protected override ServicoCrud<Parcelamento> Servico => ServicoDeParcelamentos;

    protected override Parcelamento CriarNovo() => new() { CompetenciaPrimeiraParcela = MesSelecionado };

    protected override string? Conferir(Parcelamento parcelamento)
        => Validacoes.Primeira(
            Validacoes.Descricao(parcelamento.Descricao),
            Validacoes.ValorPositivo(parcelamento.ValorTotal),
            Validacoes.QuantidadeParcelas(parcelamento.QuantidadeParcelas));

    protected override string DescreverParaExclusao(Parcelamento parcelamento)
        => $"o parcelado {parcelamento.Descricao}";

    private IReadOnlyList<Parcelamento> ParcelamentosVisiveis
        => MostrarSomenteDoMes
            ? [.. Itens.Where(parcelamento => DescritorParcelamento.CaiNoMes(parcelamento, MesSelecionado))]
            : Itens;

    private static void DefinirPrimeiraParcela(Parcelamento parcelamento, Competencia? mes)
        => parcelamento.CompetenciaPrimeiraParcela = mes ?? parcelamento.CompetenciaPrimeiraParcela;

    private static string MontarPrevia(Parcelamento parcelamento)
        => parcelamento.ValorTotal <= 0 || parcelamento.QuantidadeParcelas < 1
            ? "Preencha o valor e o número de parcelas."
            : $"{DescritorParcelamento.Parcelas(parcelamento)} · {DescritorParcelamento.Periodo(parcelamento)}";
}
