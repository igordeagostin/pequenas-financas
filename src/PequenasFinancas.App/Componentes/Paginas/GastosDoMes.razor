@page "/gastos-do-mes"
@namespace PequenasFinancas.App.Componentes.Paginas
@inherits PaginaCadastro<GastoAvulso>
@inject ServicoGastosAvulsos ServicoDeGastosAvulsos

<CabecalhoPagina Titulo="Gastos do mês"
                 Explicacao="Aquele gasto solto, pago à vista, que não se repete e não está no cartão.">
    <Acoes>
        <button class="botao" @onclick="AbrirNovo">+ Novo gasto</button>
    </Acoes>
</CabecalhoPagina>

<div class="painel">
    <div class="painel-cabecalho">
        <h2>Gastos de @MesSelecionado.NomeExtenso</h2>
        <span class="texto-suave texto-pequeno">
            Total: <strong class="texto-saida">@Dinheiro.Formatar(TotalDoMes)</strong>
        </span>
    </div>

    @if (GastosDesteMes.Count == 0)
    {
        <EstadoVazio Icone="•" Mensagem="Nenhum gasto solto neste mês.">
            <Acao>
                <button class="botao" @onclick="AbrirNovo">Registrar um gasto</button>
            </Acao>
        </EstadoVazio>
    }
    else
    {
        <table class="tabela">
            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Categoria</th>
                    <th>Dia</th>
                    <th class="direita">Valor</th>
                    <th class="acoes"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (GastoAvulso gasto in GastosDesteMes)
                {
                    <tr>
                        <td><strong>@gasto.Descricao</strong></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(gasto.Categoria))
                            {
                                <span class="etiqueta">@gasto.Categoria</span>
                            }
                        </td>
                        <td class="texto-suave">@gasto.Data.ToString("dd/MM")</td>
                        <td class="direita numero texto-saida">@Dinheiro.Formatar(gasto.Valor)</td>
                        <td class="acoes">
                            <button class="botao botao-secundario" @onclick="() => AbrirEdicao(gasto)">Editar</button>
                            <button class="botao botao-perigo" @onclick="() => PedirExclusao(gasto)">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<ModalFormulario Visivel="FormularioAberto"
                 Titulo="@(EhCadastroNovo ? "Novo gasto do mês" : "Editar gasto")"
                 Erro="@MensagemDeErro"
                 AoConfirmar="ConfirmarFormulario"
                 AoCancelar="FecharFormulario">
    @if (ItemEmEdicao is GastoAvulso gasto)
    {
        <div class="campo">
            <label>No que você gastou</label>
            <input type="text" placeholder="Ex.: Farmácia" @bind="gasto.Descricao" @bind:event="oninput" />
        </div>

        <div class="linha-campos">
            <CampoMoeda Rotulo="Valor" @bind-Valor="gasto.Valor" />

            <div class="campo">
                <label>Data</label>
                <input type="date" @bind="gasto.Data" @bind:event="oninput" />
            </div>

            <div class="campo">
                <label>Categoria</label>
                <input type="text" placeholder="Ex.: Saúde" @bind="gasto.Categoria" @bind:event="oninput" />
            </div>
        </div>
    }
</ModalFormulario>

<ModalConfirmacao Visivel="ItemParaExcluir is not null"
                  Descricao="@(ItemParaExcluir is null ? string.Empty : DescreverParaExclusao(ItemParaExcluir))"
                  AoConfirmar="ConfirmarExclusao"
                  AoCancelar="CancelarExclusao" />

@code {
    private IReadOnlyList<GastoAvulso> GastosDesteMes = [];

    protected override ServicoCrud<GastoAvulso> Servico => ServicoDeGastosAvulsos;

    protected override void Recarregar()
    {
        base.Recarregar();
        GastosDesteMes = ServicoDeGastosAvulsos.ListarDoMes(MesSelecionado);
    }

    protected override GastoAvulso CriarNovo() => new()
    {
        Competencia = MesSelecionado,
        Data = MesSelecionado.PrimeiroDia
    };

    protected override string? Conferir(GastoAvulso gasto)
    {
        string? mensagem = Validacoes.Primeira(
            Validacoes.Descricao(gasto.Descricao),
            Validacoes.ValorPositivo(gasto.Valor));

        if (mensagem is null)
        {
            gasto.Competencia = Competencia.DaData(gasto.Data);
        }

        return mensagem;
    }

    protected override string DescreverParaExclusao(GastoAvulso gasto) => $"o gasto {gasto.Descricao}";

    private decimal TotalDoMes => GastosDesteMes.Sum(gasto => gasto.Valor);
}
