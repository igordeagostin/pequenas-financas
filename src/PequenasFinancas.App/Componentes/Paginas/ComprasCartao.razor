@page "/compras"
@namespace PequenasFinancas.App.Componentes.Paginas
@inherits PaginaCadastro<CompraCartao>
@inject ServicoComprasCartao ServicoDeCompras
@inject ServicoCartoes ServicoDeCartoes

<CabecalhoPagina Titulo="Compras no cartão"
                 Explicacao="Lance a compra uma vez e as parcelas aparecem sozinhas em cada mês.">
    <Acoes>
        <div class="acoes-em-linha">
            @if (CartoesDisponiveis.Count > 0)
            {
                <a class="botao botao-secundario" href="compras/importar">
                    <Icone Nome="NomeIcone.Importar" /> Importar fatura
                </a>
            }
            <button class="botao" @onclick="AbrirNovo" disabled="@(CartoesDisponiveis.Count == 0)">
                <Icone Nome="NomeIcone.Adicionar" /> Nova compra
            </button>
        </div>
    </Acoes>
</CabecalhoPagina>

@if (CartoesDisponiveis.Count == 0)
{
    <div class="painel">
        <EstadoVazio Simbolo="NomeIcone.Cartao" Mensagem="Cadastre um cartão antes de lançar compras.">
            <Acao>
                <a class="botao" href="cartoes">Ir para cartões</a>
            </Acao>
        </EstadoVazio>
    </div>
}
else
{
    <div class="painel">
        <div class="painel-cabecalho">
            <div>
                <h2>@Titulo</h2>
                <p class="texto-suave texto-pequeno">@Resumo</p>
            </div>
            <div class="acoes-em-linha">
                @if (VendoTodasAsCompras)
                {
                    <select class="filtro" value="@CartaoFiltrado" @onchange="TrocarCartaoFiltrado">
                        <option value="">Todos os cartões</option>
                        @foreach (Cartao cartao in CartoesDisponiveis)
                        {
                            <option value="@cartao.Id">@cartao.Nome</option>
                        }
                    </select>
                }
                <button class="botao @(VendoTodasAsCompras ? "botao-secundario" : null)"
                        @onclick="VerParcelasDoMes">
                    Parcelas do mês
                </button>
                <button class="botao @(VendoTodasAsCompras ? null : "botao-secundario")"
                        @onclick="VerTodasAsCompras">
                    Todas as compras
                </button>
            </div>
        </div>

        @if (VendoTodasAsCompras)
        {
            @if (ComprasFiltradas.Count == 0)
            {
                <EstadoVazio Simbolo="NomeIcone.Compra" Mensagem="Nenhuma compra lançada ainda.">
                    <Acao>
                        <button class="botao" @onclick="AbrirNovo">Lançar minha primeira compra</button>
                    </Acao>
                </EstadoVazio>
            }
            else
            {
                <table class="tabela">
                    <thead>
                        <tr>
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDeTodas" Coluna="Compra" />
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDeTodas" Coluna="Cartão" />
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDeTodas" Coluna="Categoria" />
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDeTodas" Coluna="Parcelas" />
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDeTodas" Coluna="Período" />
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDeTodas" Coluna="Total" Classe="direita" />
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDeTodas" Coluna="Falta pagar" Classe="direita" />
                            <th class="acoes"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CompraCartao compra in OrdenacaoDeTodas.Aplicar(ComprasFiltradas))
                        {
                            <tr>
                                <td>
                                    <strong>@compra.Descricao</strong>
                                    @if (compra.ParcelasRemovidas.Count > 0)
                                    {
                                        <div class="texto-suave texto-pequeno">@DescreverParcelasRemovidas(compra)</div>
                                    }
                                </td>
                                <td>
                                    <NomeColorido Nome="@ObterNomeDoCartao(compra.CartaoId)"
                                                  Cor="@ObterCorDoCartao(compra.CartaoId)" />
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(compra.Categoria))
                                    {
                                        <span class="etiqueta">@compra.Categoria</span>
                                    }
                                </td>
                                <td class="numero">@DescritorParcelamento.Parcelas(compra)</td>
                                <td class="texto-suave">@DescritorParcelamento.Periodo(compra)</td>
                                <td class="direita numero">
                                    @Dinheiro.Formatar(DescritorParcelamento.ValorQueSobrou(compra))
                                </td>
                                <td class="direita numero">
                                    @Dinheiro.Formatar(DescritorParcelamento.ValorEmAberto(compra, MesSelecionado))
                                </td>
                                <td class="acoes">
                                    <button class="botao botao-secundario" @onclick="() => AbrirEdicao(compra)">Editar</button>
                                    <button class="botao botao-perigo" @onclick="() => PedirExclusao(compra)">Excluir</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else
        {
            @if (ParcelasDoMes.Count == 0)
            {
                <EstadoVazio Simbolo="NomeIcone.Compra"
                             Mensagem="@($"Nenhuma parcela cai em {MesSelecionado.NomeExtenso}.")">
                    <Acao>
                        <button class="botao botao-secundario" @onclick="VerTodasAsCompras">
                            Ver todas as compras
                        </button>
                    </Acao>
                </EstadoVazio>
            }
            else
            {
                <table class="tabela">
                    <thead>
                        <tr>
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDoMes" Coluna="Compra" />
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDoMes" Coluna="Cartão" />
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDoMes" Coluna="Parcela" />
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDoMes" Coluna="Período" />
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDoMes" Coluna="Neste mês" Classe="direita" />
                            <CabecalhoOrdenavel Ordenacao="OrdenacaoDoMes" Coluna="Falta pagar" Classe="direita" />
                            <th class="acoes"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CompraCartao compra in OrdenacaoDoMes.Aplicar(ParcelasDoMes))
                        {
                            <tr>
                                <td>
                                    <strong>@compra.Descricao</strong>
                                    <div class="texto-suave texto-pequeno">
                                        @DescritorParcelamento.Parcelas(compra)
                                        @if (!string.IsNullOrWhiteSpace(compra.Categoria))
                                        {
                                            <text> · @compra.Categoria</text>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <NomeColorido Nome="@ObterNomeDoCartao(compra.CartaoId)"
                                                  Cor="@ObterCorDoCartao(compra.CartaoId)" />
                                </td>
                                <td class="numero">@DescritorParcelamento.ParcelaDoMes(compra, MesSelecionado)</td>
                                <td class="texto-suave">@DescritorParcelamento.Periodo(compra)</td>
                                <td class="direita numero texto-saida">
                                    @Dinheiro.Formatar(DescritorParcelamento.ValorNoMes(compra, MesSelecionado))
                                </td>
                                <td class="direita numero">
                                    @Dinheiro.Formatar(DescritorParcelamento.ValorEmAberto(compra, MesSelecionado))
                                </td>
                                <td class="acoes">
                                    <button class="botao botao-secundario" @onclick="() => AbrirEdicao(compra)">Editar</button>
                                    <button class="botao botao-perigo" @onclick="() => PedirExclusao(compra)">Excluir</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
}

<ModalFormulario Visivel="FormularioAberto"
                 Titulo="@(EhCadastroNovo ? "Nova compra no cartão" : "Editar compra")"
                 Erro="@MensagemDeErro"
                 AoConfirmar="ConfirmarFormulario"
                 AoCancelar="FecharFormulario">
    @if (ItemEmEdicao is CompraCartao compra)
    {
        <FormularioCompra Compra="compra" Cartoes="CartoesDisponiveis" />
    }
</ModalFormulario>

<ModalExclusaoDeCompra Visivel="ItemParaExcluir is not null"
                       Descricao="@(ItemParaExcluir?.Descricao ?? string.Empty)"
                       Mes="MesSelecionado"
                       PodeExcluirSomenteAParcela="PodeExcluirSomenteAParcela"
                       AoExcluirSomenteAParcela="ExcluirSomenteAParcela"
                       AoExcluirACompra="ConfirmarExclusao"
                       AoCancelar="CancelarExclusao" />

@code {
    private readonly OrdenacaoDaTabela<CompraCartao> OrdenacaoDoMes = new();

    private readonly OrdenacaoDaTabela<CompraCartao> OrdenacaoDeTodas = new();

    private IReadOnlyList<Cartao> CartoesDisponiveis = [];

    private IReadOnlyList<CompraCartao> ParcelasDoMes = [];

    private bool VendoTodasAsCompras;

    private string CartaoFiltrado = string.Empty;

    protected override ServicoCrud<CompraCartao> Servico => ServicoDeCompras;

    protected override void OnInitialized()
    {
        OrdenacaoDoMes
            .Coluna("Compra", compra => compra.Descricao)
            .Coluna("Cartão", compra => ObterNomeDoCartao(compra.CartaoId))
            .Coluna("Parcela", compra => DescritorParcelamento.NumeroDaParcelaNoMes(compra, MesSelecionado))
            .Coluna("Período", compra => compra.CompetenciaPrimeiraParcela)
            .Coluna("Neste mês", compra => DescritorParcelamento.ValorNoMes(compra, MesSelecionado))
            .Coluna("Falta pagar", compra => DescritorParcelamento.ValorEmAberto(compra, MesSelecionado))
            .RedesenharCom(StateHasChanged);

        OrdenacaoDeTodas
            .Coluna("Compra", compra => compra.Descricao)
            .Coluna("Cartão", compra => ObterNomeDoCartao(compra.CartaoId))
            .Coluna("Categoria", compra => compra.Categoria)
            .Coluna("Parcelas", compra => compra.QuantidadeParcelas)
            .Coluna("Período", compra => compra.CompetenciaPrimeiraParcela)
            .Coluna("Total", compra => DescritorParcelamento.ValorQueSobrou(compra))
            .Coluna("Falta pagar", compra => DescritorParcelamento.ValorEmAberto(compra, MesSelecionado))
            .RedesenharCom(StateHasChanged);

        base.OnInitialized();
    }

    protected override void Recarregar()
    {
        base.Recarregar();
        CartoesDisponiveis = ServicoDeCartoes.ListarAtivos();
        ParcelasDoMes = ServicoDeCompras.ListarDoMes(MesSelecionado);
    }

    protected override CompraCartao CriarNovo() => new()
    {
        CartaoId = CartoesDisponiveis.FirstOrDefault()?.Id ?? Guid.Empty,
        CompetenciaPrimeiraParcela = MesSelecionado
    };

    protected override string? Conferir(CompraCartao compra)
        => Validacoes.Primeira(
            Validacoes.Descricao(compra.Descricao),
            Validacoes.Selecionado(compra.CartaoId, "um cartão"),
            Validacoes.ValorPositivo(compra.ValorTotal),
            Validacoes.QuantidadeParcelas(compra.QuantidadeParcelas));

    protected override string DescreverParaExclusao(CompraCartao compra) => $"a compra {compra.Descricao}";

    private string Titulo
        => VendoTodasAsCompras ? "Todas as compras" : $"Parcelas de {MesSelecionado.NomeExtenso}";

    private string Resumo
        => VendoTodasAsCompras
            ? DescreverTodasAsCompras()
            : DescreverParcelasDoMes();

    private IReadOnlyList<CompraCartao> ComprasFiltradas
        => CartaoEscolhido is Guid cartaoId
            ? [.. Itens.Where(compra => compra.CartaoId == cartaoId)]
            : Itens;

    private Guid? CartaoEscolhido => Guid.TryParse(CartaoFiltrado, out Guid cartaoId) ? cartaoId : null;

    private bool PodeExcluirSomenteAParcela
        => !VendoTodasAsCompras
        && ItemParaExcluir is CompraCartao compra
        && ServicoParcelas.PossuiParcelaEm(compra, MesSelecionado);

    private string ObterNomeDoCartao(Guid cartaoId) => ServicoDeCartoes.ObterNome(cartaoId);

    private string ObterCorDoCartao(Guid cartaoId) => ServicoDeCartoes.Obter(cartaoId)?.Cor ?? "var(--text-suave)";

    private void VerParcelasDoMes() => VendoTodasAsCompras = false;

    private void VerTodasAsCompras() => VendoTodasAsCompras = true;

    private void TrocarCartaoFiltrado(ChangeEventArgs evento)
        => CartaoFiltrado = evento.Value?.ToString() ?? string.Empty;

    private void ExcluirSomenteAParcela()
    {
        if (ItemParaExcluir is null)
        {
            return;
        }

        ServicoDeCompras.RemoverParcela(ItemParaExcluir.Id, MesSelecionado);
        CancelarExclusao();
        Recarregar();
    }

    private string DescreverParcelasDoMes()
        => ParcelasDoMes.Count == 0
            ? "Nenhuma parcela neste mês."
            : $"{DescreverQuantidadeDeParcelas(ParcelasDoMes.Count)} · {Dinheiro.Formatar(TotalDoMes)} neste mês";

    private string DescreverTodasAsCompras()
        => ComprasFiltradas.Count == 0
            ? "Nenhuma compra lançada ainda."
            : $"{DescreverQuantidadeDeCompras(ComprasFiltradas.Count)} · {Dinheiro.Formatar(TotalDasCompras)} no total";

    private decimal TotalDoMes
        => ParcelasDoMes.Sum(compra => DescritorParcelamento.ValorNoMes(compra, MesSelecionado));

    private decimal TotalDasCompras
        => ComprasFiltradas.Sum(compra => DescritorParcelamento.ValorQueSobrou(compra));

    private static string DescreverParcelasRemovidas(CompraCartao compra)
        => compra.ParcelasRemovidas.Count == 1
            ? "1 parcela excluída"
            : $"{compra.ParcelasRemovidas.Count} parcelas excluídas";

    private static string DescreverQuantidadeDeParcelas(int quantidade)
        => quantidade == 1 ? "1 parcela" : $"{quantidade} parcelas";

    private static string DescreverQuantidadeDeCompras(int quantidade)
        => quantidade == 1 ? "1 compra" : $"{quantidade} compras";
}
