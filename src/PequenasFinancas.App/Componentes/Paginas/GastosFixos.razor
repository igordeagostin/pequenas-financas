@page "/gastos-fixos"
@namespace PequenasFinancas.App.Componentes.Paginas
@inherits PaginaCadastro<GastoFixo>
@inject ServicoGastosFixos ServicoDeGastosFixos

<CabecalhoPagina Titulo="Gastos fixos"
                 Explicacao="Contas que se repetem todo mês, como aluguel, internet e escola.">
    <Acoes>
        <button class="botao" @onclick="AbrirNovo"><Icone Nome="NomeIcone.Adicionar" /> Novo gasto fixo</button>
    </Acoes>
</CabecalhoPagina>

<div class="painel">
    <div class="painel-cabecalho">
        <h2>Suas contas de todo mês</h2>
        <span class="texto-suave texto-pequeno">
            Total em @MesSelecionado.NomeExtenso:
            <strong class="texto-saida">@Dinheiro.Formatar(TotalDoMes)</strong>
        </span>
    </div>

    @if (Itens.Count == 0)
    {
        <EstadoVazio Simbolo="NomeIcone.GastoFixo" Mensagem="Nenhum gasto fixo cadastrado ainda.">
            <Acao>
                <button class="botao" @onclick="AbrirNovo">Cadastrar meu primeiro gasto fixo</button>
            </Acao>
        </EstadoVazio>
    }
    else
    {
        <table class="tabela">
            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Categoria</th>
                    <th>Vence</th>
                    <th>Período</th>
                    <th class="direita">Valor neste mês</th>
                    <th class="acoes"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (GastoFixo gasto in Itens)
                {
                    bool valeNesteMes = ServicoRecorrencia.EstaVigenteEm(gasto, MesSelecionado);

                    <tr>
                        <td><strong>@gasto.Descricao</strong></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(gasto.Categoria))
                            {
                                <span class="etiqueta">@gasto.Categoria</span>
                            }
                        </td>
                        <td class="texto-suave">dia @gasto.DiaVencimento</td>
                        <td class="texto-suave">@DescreverPeriodo(gasto)</td>
                        <td class="direita numero @(valeNesteMes ? "texto-saida" : "texto-suave")">
                            @(valeNesteMes
                                ? Dinheiro.Formatar(ServicoRecorrencia.ValorNoMes(gasto, MesSelecionado))
                                : "não vale neste mês")
                        </td>
                        <td class="acoes">
                            <button class="botao botao-secundario" @onclick="() => AbrirEdicao(gasto)">Editar</button>
                            <button class="botao botao-perigo" @onclick="() => PedirExclusao(gasto)">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<ModalFormulario Visivel="FormularioAberto"
                 Titulo="@(EhCadastroNovo ? "Novo gasto fixo" : "Editar gasto fixo")"
                 Erro="@MensagemDeErro"
                 AoConfirmar="ConfirmarFormulario"
                 AoCancelar="FecharFormulario">
    @if (ItemEmEdicao is GastoFixo gasto)
    {
        <div class="campo">
            <label>Descrição</label>
            <input type="text" placeholder="Ex.: Aluguel" @bind="gasto.Descricao" @bind:event="oninput" />
        </div>

        <div class="linha-campos">
            <CampoMoeda Rotulo="Valor por mês" @bind-Valor="gasto.Valor" />

            <div class="campo">
                <label>Categoria</label>
                <input type="text" placeholder="Ex.: Moradia" @bind="gasto.Categoria" @bind:event="oninput" />
            </div>

            <div class="campo">
                <label>Dia do vencimento</label>
                <input type="number" min="1" max="31" @bind="gasto.DiaVencimento" @bind:event="oninput" />
            </div>
        </div>

        <div class="linha-campos">
            <CampoMes Rotulo="Começa em" Valor="gasto.VigenciaInicio"
                      ValorChanged="mes => DefinirInicio(gasto, mes)" />

            <CampoMes Rotulo="Termina em (opcional)" Valor="gasto.VigenciaFim"
                      ValorChanged="mes => gasto.VigenciaFim = mes"
                      Ajuda="Preencha quando a conta tem data para acabar." />
        </div>
    }
</ModalFormulario>

<ModalConfirmacao Visivel="ItemParaExcluir is not null"
                  Descricao="@(ItemParaExcluir is null ? string.Empty : DescreverParaExclusao(ItemParaExcluir))"
                  AoConfirmar="ConfirmarExclusao"
                  AoCancelar="CancelarExclusao" />

@code {
    protected override ServicoCrud<GastoFixo> Servico => ServicoDeGastosFixos;

    protected override GastoFixo CriarNovo() => new() { VigenciaInicio = MesSelecionado };

    protected override string? Conferir(GastoFixo gasto)
        => Validacoes.Primeira(
            Validacoes.Descricao(gasto.Descricao),
            Validacoes.ValorPositivo(gasto.Valor),
            Validacoes.DiaDoMes(gasto.DiaVencimento),
            ConferirPeriodo(gasto));

    protected override string DescreverParaExclusao(GastoFixo gasto) => $"o gasto fixo {gasto.Descricao}";

    private decimal TotalDoMes => ServicoRecorrencia.SomarNoMes(Itens, MesSelecionado);

    private static string? ConferirPeriodo(GastoFixo gasto)
        => gasto.VigenciaFim is Competencia fim && fim < gasto.VigenciaInicio
            ? "O mês final não pode ser antes do mês inicial."
            : null;

    private static void DefinirInicio(GastoFixo gasto, Competencia? mes)
        => gasto.VigenciaInicio = mes ?? gasto.VigenciaInicio;

    private static string DescreverPeriodo(GastoFixo gasto)
        => gasto.VigenciaFim is Competencia fim
            ? $"{gasto.VigenciaInicio.NomeCurto} até {fim.NomeCurto}"
            : $"desde {gasto.VigenciaInicio.NomeCurto}";
}
