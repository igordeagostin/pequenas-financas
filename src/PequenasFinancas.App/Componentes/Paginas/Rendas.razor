@page "/rendas"
@namespace PequenasFinancas.App.Componentes.Paginas
@inherits PaginaCadastro<FonteRenda>
@inject ServicoRendas ServicoDeRendas
@inject ServicoRendasExtras ServicoDeRendasExtras

<CabecalhoPagina Titulo="Renda"
                 Explicacao="Cadastre o dinheiro que entra todo mês. Ele aparece sozinho nos próximos meses.">
    <Acoes>
        <button class="botao" @onclick="AbrirNovo"><Icone Nome="NomeIcone.Adicionar" /> Nova renda</button>
    </Acoes>
</CabecalhoPagina>

<div class="painel">
    <div class="painel-cabecalho">
        <h2>Renda de todo mês</h2>
        <span class="texto-suave texto-pequeno">Valores de @MesSelecionado.NomeExtenso</span>
    </div>

    @if (Itens.Count == 0)
    {
        <EstadoVazio Simbolo="NomeIcone.Renda" Mensagem="Comece cadastrando sua renda principal, como o salário.">
            <Acao>
                <button class="botao" @onclick="AbrirNovo">Cadastrar minha renda</button>
            </Acao>
        </EstadoVazio>
    }
    else
    {
        <table class="tabela">
            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Tipo</th>
                    <th>Período</th>
                    <th class="direita">Valor neste mês</th>
                    <th class="acoes"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (FonteRenda renda in Itens)
                {
                    bool valeNesteMes = ServicoRecorrencia.EstaVigenteEm(renda, MesSelecionado);

                    <tr>
                        <td>
                            <strong>@renda.Descricao</strong>
                            <div class="texto-suave texto-pequeno">Recebe no dia @renda.DiaRecebimento</div>
                        </td>
                        <td>
                            <span class="etiqueta">
                                @(renda.Tipo == TipoRenda.Principal ? "Principal" : "Complementar")
                            </span>
                        </td>
                        <td class="texto-suave">@DescreverPeriodo(renda)</td>
                        <td class="direita numero @(valeNesteMes ? "texto-entrada" : "texto-suave")">
                            @(valeNesteMes
                                ? Dinheiro.Formatar(ServicoRecorrencia.ValorNoMes(renda, MesSelecionado))
                                : "não vale neste mês")
                        </td>
                        <td class="acoes">
                            <button class="botao botao-secundario" @onclick="() => AbrirEdicao(renda)">Editar</button>
                            <button class="botao botao-perigo" @onclick="() => PedirExclusao(renda)">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="painel">
    <div class="painel-cabecalho">
        <div>
            <h2>Entrou só neste mês</h2>
            <div class="texto-suave texto-pequeno">
                Freelance, 13º, venda, presente — vale apenas para @MesSelecionado.NomeExtenso
            </div>
        </div>
        <button class="botao botao-secundario" @onclick="AbrirNovaRendaExtra">
            <Icone Nome="NomeIcone.Adicionar" /> Nova entrada
        </button>
    </div>

    @if (RendasExtras.Count == 0)
    {
        <EstadoVazio Simbolo="NomeIcone.Entrada" Mensagem="Nenhuma entrada extra neste mês." />
    }
    else
    {
        <table class="tabela">
            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Dia</th>
                    <th class="direita">Valor</th>
                    <th class="acoes"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (RendaExtra renda in RendasExtras)
                {
                    <tr>
                        <td><strong>@renda.Descricao</strong></td>
                        <td class="texto-suave">@renda.Data.ToString("dd/MM")</td>
                        <td class="direita numero texto-entrada">@Dinheiro.Formatar(renda.Valor)</td>
                        <td class="acoes">
                            <button class="botao botao-secundario" @onclick="() => AbrirEdicaoDeRendaExtra(renda)">Editar</button>
                            <button class="botao botao-perigo" @onclick="() => ExcluirRendaExtra(renda)">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<ModalFormulario Visivel="FormularioAberto"
                 Titulo="@(EhCadastroNovo ? "Nova renda" : "Editar renda")"
                 Erro="@MensagemDeErro"
                 AoConfirmar="ConfirmarFormulario"
                 AoCancelar="FecharFormulario">
    @if (ItemEmEdicao is FonteRenda renda)
    {
        <div class="campo">
            <label>Descrição</label>
            <input type="text" placeholder="Ex.: Salário" @bind="renda.Descricao" @bind:event="oninput" />
        </div>

        <div class="linha-campos">
            <CampoMoeda Rotulo="Valor por mês" @bind-Valor="renda.Valor" />

            <div class="campo">
                <label>Tipo</label>
                <select @bind="renda.Tipo">
                    <option value="@TipoRenda.Principal">Renda principal</option>
                    <option value="@TipoRenda.Complementar">Renda complementar</option>
                </select>
            </div>

            <div class="campo">
                <label>Dia do recebimento</label>
                <input type="number" min="1" max="31" @bind="renda.DiaRecebimento" @bind:event="oninput" />
            </div>
        </div>

        <div class="linha-campos">
            <CampoMes Rotulo="Começa em" Valor="renda.VigenciaInicio"
                      ValorChanged="mes => DefinirInicio(renda, mes)" />

            <CampoMes Rotulo="Termina em (opcional)" Valor="renda.VigenciaFim"
                      ValorChanged="mes => renda.VigenciaFim = mes"
                      Ajuda="Deixe em branco se não tem data para acabar." />
        </div>
    }
</ModalFormulario>

<ModalFormulario Visivel="RendaExtraEmEdicao is not null"
                 Titulo="Entrada só deste mês"
                 Erro="@ErroDaRendaExtra"
                 AoConfirmar="ConfirmarRendaExtra"
                 AoCancelar="FecharRendaExtra">
    @if (RendaExtraEmEdicao is RendaExtra extra)
    {
        <div class="campo">
            <label>Descrição</label>
            <input type="text" placeholder="Ex.: Freela do site" @bind="extra.Descricao" @bind:event="oninput" />
        </div>

        <div class="linha-campos">
            <CampoMoeda Rotulo="Valor" @bind-Valor="extra.Valor" />

            <div class="campo">
                <label>Data</label>
                <input type="date" @bind="extra.Data" @bind:event="oninput" />
            </div>
        </div>
    }
</ModalFormulario>

<ModalConfirmacao Visivel="ItemParaExcluir is not null"
                  Descricao="@(ItemParaExcluir is null ? string.Empty : DescreverParaExclusao(ItemParaExcluir))"
                  AoConfirmar="ConfirmarExclusao"
                  AoCancelar="CancelarExclusao" />

@code {
    private IReadOnlyList<RendaExtra> RendasExtras = [];
    private RendaExtra? RendaExtraEmEdicao;
    private string? ErroDaRendaExtra;

    protected override ServicoCrud<FonteRenda> Servico => ServicoDeRendas;

    protected override FonteRenda CriarNovo() => new() { VigenciaInicio = MesSelecionado };

    protected override void Recarregar()
    {
        base.Recarregar();
        RendasExtras = ServicoDeRendasExtras.ListarDoMes(MesSelecionado);
    }

    protected override string? Conferir(FonteRenda renda)
        => Validacoes.Primeira(
            Validacoes.Descricao(renda.Descricao),
            Validacoes.ValorPositivo(renda.Valor),
            Validacoes.DiaDoMes(renda.DiaRecebimento),
            ConferirPeriodo(renda));

    protected override string DescreverParaExclusao(FonteRenda renda) => $"a renda {renda.Descricao}";

    private static string? ConferirPeriodo(FonteRenda renda)
        => renda.VigenciaFim is Competencia fim && fim < renda.VigenciaInicio
            ? "O mês final não pode ser antes do mês inicial."
            : null;

    private static void DefinirInicio(FonteRenda renda, Competencia? mes)
        => renda.VigenciaInicio = mes ?? renda.VigenciaInicio;

    private static string DescreverPeriodo(FonteRenda renda)
        => renda.VigenciaFim is Competencia fim
            ? $"{renda.VigenciaInicio.NomeCurto} até {fim.NomeCurto}"
            : $"desde {renda.VigenciaInicio.NomeCurto}";

    private void AbrirNovaRendaExtra()
    {
        ErroDaRendaExtra = null;
        RendaExtraEmEdicao = new RendaExtra
        {
            Competencia = MesSelecionado,
            Data = MesSelecionado.PrimeiroDia
        };
    }

    private void AbrirEdicaoDeRendaExtra(RendaExtra renda)
    {
        ErroDaRendaExtra = null;
        RendaExtraEmEdicao = Clonador.Clonar(renda);
    }

    private void FecharRendaExtra()
    {
        RendaExtraEmEdicao = null;
        ErroDaRendaExtra = null;
    }

    private void ConfirmarRendaExtra()
    {
        if (RendaExtraEmEdicao is null)
        {
            return;
        }

        ErroDaRendaExtra = Validacoes.Primeira(
            Validacoes.Descricao(RendaExtraEmEdicao.Descricao),
            Validacoes.ValorPositivo(RendaExtraEmEdicao.Valor));

        if (ErroDaRendaExtra is not null)
        {
            return;
        }

        RendaExtraEmEdicao.Competencia = Competencia.DaData(RendaExtraEmEdicao.Data);
        ServicoDeRendasExtras.Salvar(RendaExtraEmEdicao);
        RendaExtraEmEdicao = null;
        Recarregar();
    }

    private void ExcluirRendaExtra(RendaExtra renda)
    {
        ServicoDeRendasExtras.Excluir(renda.Id);
        Recarregar();
    }
}
