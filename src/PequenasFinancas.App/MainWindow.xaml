<Window x:Class="PequenasFinancas.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:componentes="clr-namespace:PequenasFinancas.App.Componentes"
        Title="Pequenas Finanças"
        Icon="logo.ico"
        Height="860" Width="1320"
        MinHeight="700" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid>
        <blazor:BlazorWebView HostPage="wwwroot\index.html"
                              Services="{DynamicResource servicos}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app"
                                      ComponentType="{x:Type componentes:Rotas}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
